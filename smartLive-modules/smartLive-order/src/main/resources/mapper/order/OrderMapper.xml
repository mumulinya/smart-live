<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartLive.order.mapper.OrderMapper">

    <resultMap type="com.smartLive.order.domain.Order" id="OrderResult">
        <result property="id"           column="id"    />
        <result property="userId"       column="user_id"    />
        <result property="sourceId"     column="source_id"    />
        <result property="sourceType"   column="source_type"  />
        <result property="payType"      column="pay_type"    />
        <result property="status"       column="status"    />

        <result property="payAmount"    column="pay_amount"    />
        <result property="amount"       column="amount"        />
        <result property="outTradeNo"   column="out_trade_no"  />
        <result property="reviewStatus" column="review_status" />
        <result property="reviewId"     column="review_id" />
        <result property="reviewTime"   column="review_time"   />
        <result property="refundAmount" column="refund_amount" />
        <result property="createTime"   column="create_time"    />
        <result property="payTime"      column="pay_time"    />
        <result property="useTime"      column="use_time"    />
        <result property="shopId"       column="shop_id" />
        <result property="refundTime"   column="refund_time"    />
        <result property="updateTime"   column="update_time"    />
        <result property="validStartTime" column="valid_start_time" />
        <result property="expireTime"   column="expire_time"    />
    </resultMap>

    <sql id="selectOrderVo">
        select id, user_id, source_id, source_type, pay_type, status,
               pay_amount, amount, out_trade_no, review_status, review_id, review_time, refund_amount,
               create_time, pay_time, use_time, shop_id, refund_time, update_time, valid_start_time, expire_time
        from `order`
    </sql>

    <select id="selectOrderList" parameterType="com.smartLive.order.domain.Order" resultMap="OrderResult">
        <include refid="selectOrderVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="sourceId != null "> and source_id = #{sourceId}</if>
            <if test="sourceType != null "> and source_type = #{sourceType}</if>
            <if test="payType != null  and payType != ''"> and pay_type = #{payType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="payTime != null "> and pay_time = #{payTime}</if>
            <if test="useTime != null "> and use_time = #{useTime}</if>
            <if test="shopId != null "> and shop_id = #{shopId}</if>
            <if test="refundTime != null "> and refund_time = #{refundTime}</if>
            <if test="outTradeNo != null and outTradeNo != ''"> and out_trade_no = #{outTradeNo}</if>
            <if test="reviewStatus != null"> and review_status = #{reviewStatus}</if>
            <if test="reviewId != null"> and review_id = #{reviewId}</if>
            <if test="validStartTime != null"> and valid_start_time = #{validStartTime}</if>
            <if test="expireTime != null"> and expire_time = #{expireTime}</if>
        </where>
    </select>

    <select id="selectOrderById" parameterType="Long" resultMap="OrderResult">
        <include refid="selectOrderVo"/>
        where id = #{id}
    </select>

    <insert id="insertOrder" parameterType="com.smartLive.order.domain.Order">
        insert into `order`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userId != null">user_id,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="payType != null">pay_type,</if>
            <if test="status != null">status,</if>
            <if test="payAmount != null">pay_amount,</if>
            <if test="amount != null">amount,</if>
            <if test="outTradeNo != null">out_trade_no,</if>
            <if test="reviewStatus != null">review_status,</if>
            <if test="reviewId != null">review_id,</if>
            <if test="reviewTime != null">review_time,</if>
            <if test="refundAmount != null">refund_amount,</if>

            <if test="createTime != null">create_time,</if>
            <if test="payTime != null">pay_time,</if>
            <if test="useTime != null">use_time,</if>
            <if test="shopId != null">shop_id,</if>
            <if test="refundTime != null">refund_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="validStartTime != null">valid_start_time,</if>
            <if test="expireTime != null">expire_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null">#{userId},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="payType != null">#{payType},</if>
            <if test="status != null">#{status},</if>
            <if test="payAmount != null">#{payAmount},</if>
            <if test="amount != null">#{amount},</if>
            <if test="outTradeNo != null">#{outTradeNo},</if>
            <if test="reviewStatus != null">#{reviewStatus},</if>
            <if test="reviewId != null">#{reviewId},</if>
            <if test="reviewTime != null">#{reviewTime},</if>
            <if test="refundAmount != null">#{refundAmount},</if>

            <if test="createTime != null">#{createTime},</if>
            <if test="payTime != null">#{payTime},</if>
            <if test="useTime != null">#{useTime},</if>
            <if test="shopId != null">#{shopId},</if>
            <if test="refundTime != null">#{refundTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="validStartTime != null">#{validStartTime},</if>
            <if test="expireTime != null">#{expireTime},</if>
        </trim>
    </insert>

    <update id="updateOrder" parameterType="com.smartLive.order.domain.Order">
        update `order`
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="payType != null">pay_type = #{payType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="payAmount != null">pay_amount = #{payAmount},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="outTradeNo != null">out_trade_no = #{outTradeNo},</if>
            <if test="reviewStatus != null">review_status = #{reviewStatus},</if>
            <if test="reviewId != null">review_id = #{reviewId},</if>
            <if test="reviewTime != null">review_time = #{reviewTime},</if>
            <if test="refundAmount != null">refund_amount = #{refundAmount},</if>

            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="useTime != null">use_time = #{useTime},</if>
            <if test="shopId != null">shop_id = #{shopId},</if>
            <if test="refundTime != null">refund_time = #{refundTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="validStartTime != null">valid_start_time = #{validStartTime},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteOrderById" parameterType="Long">
        delete from `order` where id = #{id}
    </delete>

    <delete id="deleteOrderByIds" parameterType="String">
        delete from `order` where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
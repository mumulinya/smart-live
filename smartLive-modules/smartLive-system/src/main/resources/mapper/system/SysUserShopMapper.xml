<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartLive.system.mapper.SysUserShopMapper">

    <resultMap type="com.smartLive.system.domain.SysUserShop" id="SysUserShopResult">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="shopId" column="shop_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insertUserShop" parameterType="com.smartLive.system.domain.SysUserShop">
        insert ignore into sys_user_shop(user_id, shop_id, create_time)
        values (#{userId}, #{shopId}, sysdate())
    </insert>

    <delete id="deleteUserShopByShopId" parameterType="Long">
        delete from sys_user_shop where shop_id = #{shopId}
    </delete>

    <delete id="deleteUserShopByShopIds" parameterType="Long">
        delete from sys_user_shop where shop_id in
        <foreach collection="array" item="shopId" open="(" separator="," close=")">
            #{shopId}
        </foreach>
    </delete>

    <select id="selectShopIdsByUserId" parameterType="Long" resultType="Long">
        select shop_id
        from sys_user_shop
        where user_id = #{userId}
        order by create_time desc, id desc
    </select>

</mapper>

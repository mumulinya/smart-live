<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.smartLive</groupId>
        <artifactId>smartLive-modules</artifactId>
        <version>3.6.6</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>smartLive-modules-wallet</artifactId>

    <description>
        smartLive wallet module
    </description>

    <dependencies>

        <!-- SpringCloud Alibaba Nacos -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- SpringCloud Alibaba Nacos Config -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- SpringCloud Alibaba Sentinel -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!-- SpringBoot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Mysql Connector -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- smartLive Common DataSource -->
        <dependency>
            <groupId>com.smartLive</groupId>
            <artifactId>smartLive-common-datasource</artifactId>
        </dependency>

        <!-- smartLive Common DataScope -->
        <dependency>
            <groupId>com.smartLive</groupId>
            <artifactId>smartLive-common-datascope</artifactId>
        </dependency>

        <!-- smartLive Common Log -->
        <dependency>
            <groupId>com.smartLive</groupId>
            <artifactId>smartLive-common-log</artifactId>
        </dependency>

        <!-- smartLive Common Swagger -->
        <dependency>
            <groupId>com.smartLive</groupId>
            <artifactId>smartLive-common-swagger</artifactId>
        </dependency>

        <!-- smartLive Common Security -->
        <dependency>
            <groupId>com.smartLive</groupId>
            <artifactId>smartLive-common-security</artifactId>
        </dependency>

        <!-- smartLive Common RabbitMQ -->
        <dependency>
            <groupId>com.smartLive</groupId>
            <artifactId>smartLive-common-rabbitmq</artifactId>
        </dependency>

        <!-- smartLive Common Seata -->
        <dependency>
            <groupId>com.smartLive</groupId>
            <artifactId>smartLive-common-seata</artifactId>
        </dependency>

        <!-- smartLive API Order (Feign) -->
        <dependency>
            <groupId>com.smartLive</groupId>
            <artifactId>smartLive-api-order</artifactId>
        </dependency>

        <!-- hutool -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.7.17</version>
        </dependency>

        <!-- zxing 二维码生成 (hutool QrCodeUtil 依赖) -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.2</version>
        </dependency>

        <!-- arthas -->
        <dependency>
            <groupId>com.taobao.arthas</groupId>
            <artifactId>arthas-spring-boot-starter</artifactId>
        </dependency>

        <!-- 微信支付V3 SDK -->
        <dependency>
            <groupId>com.github.wechatpay-apiv3</groupId>
            <artifactId>wechatpay-java</artifactId>
            <version>0.2.14</version>
        </dependency>

        <!-- 支付宝 SDK -->
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>4.38.61.ALL</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
